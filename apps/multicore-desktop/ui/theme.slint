// TerrieFlow Depth & Glow: dark navy layers with restrained cyan illumination.
// Keep these colors centralized: the desktop window and the tray share the same
// visual hierarchy and must never drift into separate themes.
export global Theme {
    out property <color> void: #030914;
    out property <color> canvas: #06101f;
    out property <color> surface: #08182b;
    out property <color> elevated: #0c2037;
    out property <color> raised: #102a46;
    out property <color> active-surface: #123c66;
    out property <color> line: #1b3c59;
    out property <color> line-soft: #15324c;
    out property <color> line-accent: #159fff8c;

    out property <color> text-primary: #f3f7ff;
    out property <color> text-secondary: #c8d7ea;
    out property <color> text-muted: #8fa5c1;

    out property <color> accent-blue: #159fff;
    out property <color> accent-blue-hover: #35d5ff;
    out property <color> accent-blue-pressed: #0b7ed1;
    out property <color> accent-cyan: #35d5ff;
    out property <color> accent-teal: #17c9b4;
    out property <color> accent-green: #18dfa1;
    out property <color> warning: #f3c34a;
    out property <color> high-latency: #fb923c;
    out property <color> error: #f0526a;
    out property <color> focus: #6ce4ff;

    out property <string> font-family: "Segoe UI Variable Text";
    out property <string> emoji-font-family: "Twemoji Mozilla";
    out property <length> type-metadata-size: 13px;
    out property <length> type-value-size: 16px;
    out property <length> type-label-size: 15px;
    out property <length> type-title-size: 22px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-title: 650;
    out property <int> weight-bold: 700;

    out property <length> radius-small: 8px;
    out property <length> radius-medium: 12px;
    out property <length> radius-large: 16px;
    out property <length> radius-panel: 18px;

    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    out property <length> interactive-min: 44px;
    out property <length> focus-width: 2px;
}
